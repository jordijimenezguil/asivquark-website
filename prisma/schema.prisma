generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Existing authentication schema: physical names and constraints preserved.
// Authentication IDs remain generated by Better Auth.
model User {
  id            String      @id @db.Text
  name          String      @db.Text
  email         String      @unique(map: "user_email_unique") @db.Text
  emailVerified Boolean     @default(false) @map("email_verified")
  image         String?     @db.Text
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  role          String      @default("user") @db.Text
  sessions      Session[]
  accounts      Account[]
  leadNotes     LeadNote[]
  leadEvents    LeadEvent[]

  @@map("user")
}

model Session {
  id        String   @id @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  token     String   @unique(map: "session_token_unique") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  ipAddress String?  @map("ip_address") @db.Text
  userAgent String?  @map("user_agent") @db.Text
  userId    String   @map("user_id") @db.Text
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "session_user_id_user_id_fk")

  @@index([userId], map: "session_user_id_idx")
  @@map("session")
}

model Account {
  id                    String    @id @db.Text
  accountId             String    @map("account_id") @db.Text
  providerId            String    @map("provider_id") @db.Text
  userId                String    @map("user_id") @db.Text
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamp(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamp(6)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "account_user_id_user_id_fk")

  @@index([userId], map: "account_user_id_idx")
  @@map("account")
}

model Verification {
  id         String   @id @db.Text
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamp(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}

// Commercial data is private; no public read API or client-editable status.
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
  SPAM
}

enum LeadEventType {
  LEAD_CREATED
  STATUS_CHANGED
  NOTE_ADDED
  NOTIFICATION_QUEUED
  NOTIFICATION_SENT
  NOTIFICATION_FAILED
  CONFIRMATION_SENT
  CONFIRMATION_FAILED
}

enum LeadEmailType {
  NOTIFICATION
  CONFIRMATION
}

enum EmailOutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model Lead {
  id                    String        @id @default(uuid()) @db.Uuid
  idempotencyKey        String        @unique @db.Uuid
  requestHash           String        @db.VarChar(64)
  name                  String        @db.VarChar(100)
  email                 String        @db.VarChar(254)
  company               String?       @db.VarChar(150)
  phone                 String?       @db.VarChar(40)
  service               String        @db.VarChar(20)
  budget                String?       @db.VarChar(30)
  message               String        @db.Text
  status                LeadStatus    @default(NEW)
  source                String        @default("contact_form") @db.VarChar(30)
  landingPath           String?       @db.VarChar(200)
  originPath            String?       @db.VarChar(200)
  referrer              String?       @db.VarChar(300)
  utmSource             String?       @db.VarChar(150)
  utmMedium             String?       @db.VarChar(150)
  utmCampaign           String?       @db.VarChar(150)
  utmContent            String?       @db.VarChar(150)
  utmTerm               String?       @db.VarChar(150)
  privacyNoticeVersion  String        @db.VarChar(100)
  privacyAcknowledgedAt DateTime      @db.Timestamptz(6)
  createdAt             DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(6)
  version               Int           @default(0)
  notes                 LeadNote[]
  events                LeadEvent[]
  emails                EmailOutbox[]

  @@index([createdAt, id])
  @@index([status, createdAt])
  @@index([service, createdAt])
  @@map("lead")
}

model LeadEvent {
  id        String        @id @default(uuid()) @db.Uuid
  leadId    String        @db.Uuid
  type      LeadEventType
  actorId   String?       @db.Text
  actor     User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  metadata  Json?
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  lead      Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_event")
}

model EmailOutbox {
  id             String            @id @default(uuid()) @db.Uuid
  leadId         String            @db.Uuid
  type           LeadEmailType
  recipient      String?           @db.VarChar(254)
  sender         String?           @db.VarChar(254)
  status         EmailOutboxStatus @default(PENDING)
  attempts       Int               @default(0)
  nextAttemptAt  DateTime          @default(now()) @db.Timestamptz(6)
  firstAttemptAt DateTime?         @db.Timestamptz(6)
  lockedUntil    DateTime?         @db.Timestamptz(6)
  lockToken      String?           @db.Uuid
  lastErrorCode  String?           @db.VarChar(60)
  providerId     String?           @db.VarChar(100)
  sentAt         DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)
  lead           Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, type])
  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}

// Short-lived keyed hashes only, never raw IP addresses or emails.
model LeadRateBucket {
  key       String   @id @db.VarChar(64)
  count     Int      @default(1)
  expiresAt DateTime @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("lead_rate_bucket")
}

model LeadNote {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  authorId  String   @db.Text
  content   String   @db.VarChar(5000)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@map("lead_note")
}

model RateLimit {
  id          String @id @db.Text
  key         String @unique @db.Text
  count       Int
  lastRequest BigInt

  @@map("auth_rate_limit")
}
