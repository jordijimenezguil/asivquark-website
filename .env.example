# Local public origin. Set production values only in Vercel Production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon PostgreSQL: pooled connection for application and Prisma CLI.
# Optional for all marketing pages; copy real URLs from the Neon console.
DATABASE_URL=
# Optional direct connection override for administrative tools.
# DIRECT_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Internal business notification recipient. Use a real controlled mailbox.
LEADS_NOTIFICATION_EMAIL=

# HMAC key for short-lived rate buckets: at least 32 random characters.
# Generate locally and store privately; never reuse BETTER_AUTH_SECRET.
LEADS_SECURITY_SECRET=


# Development contact banner only; VERCEL_ENV remains authoritative for URLs/indexing.
NEXT_PUBLIC_ENV=development
