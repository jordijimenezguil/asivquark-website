# Local public origin. Set production values only in Vercel Production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon PostgreSQL: application (pooled) and CLI (direct) connections.
# Optional for all marketing pages; copy real URLs from the Neon console.
DATABASE_URL=
DIRECT_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Internal business notification recipient. Use a real controlled mailbox.
LEADS_NOTIFICATION_EMAIL=
# Explicit opt-in for real transactional sends; keep false in tests/development.
LEADS_EMAIL_ENABLED=false

# HMAC key for short-lived rate buckets: at least 32 random characters.
# Generate locally and store privately; never reuse BETTER_AUTH_SECRET.
LEADS_SECURITY_SECRET=

# Production/preview capture stays closed until all prerequisites are ready.
LEADS_ENABLED=false
# HTTPS URL of an actual approved notice; never a placeholder page.
LEADS_PRIVACY_NOTICE_URL=
# Version of that notice, recorded with each acknowledgement.
LEADS_PRIVACY_NOTICE_VERSION=
# Required for public capture; configure after determining the retention policy.
# Local test mode uses 90 days. Cleanup must be run by a restricted operator/job.
LEADS_RETENTION_DAYS=
