{
  "name": "asivquark-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test:marketing": "node --conditions=react-server --import tsx --test tests/marketing.test.ts",
    "test:config": "node --experimental-strip-types --test tests/site.test.ts",
    "test:db": "node --experimental-strip-types --test tests/prisma-schema.test.ts",
    "test:leads": "node --conditions=react-server --import tsx --test tests/leads*.test.ts",
    "leads:process": "node --conditions=react-server --import tsx scripts/leads-maintenance.ts process",
    "admin:account": "node --conditions=react-server --import tsx scripts/admin-account.ts",
    "test:crm": "node --conditions=react-server --import tsx --test tests/crm*.test.ts",
    "test:cookies": "node --import tsx --test tests/cookies.test.ts",
    "test:automation": "node --conditions=react-server --import tsx --test tests/automation.test.ts",
    "test:automation:html": "node --import tsx --test tests/automation-html.test.ts",
    "test:web-design": "node --import tsx --test tests/web-design.test.ts",
    "test:web-design:html": "node --import tsx --test tests/web-design-html.test.ts tests/blog-html.test.ts",
    "legal:check": "node --import tsx scripts/legal-readiness.ts",
    "test:legal": "node --conditions=react-server --import tsx --test tests/legal.test.ts",
    "test:legal:html": "node --import tsx --test tests/legal-html.test.ts",
    "test:home": "node --import tsx --test tests/home-hero.test.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.7",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tailwindcss/typography": "^0.5.20",
    "better-auth": "1.7.7",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.55.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.4.0",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-slug": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/env": "16.4.0",
    "@tailwindcss/turbopack": "^4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
